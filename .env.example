# Copy to .env and adjust for your machine/environment. .env is gitignored — never commit it.
#
# This file is consumed ONLY by docker compose (Postgres). The API reads its own secrets from
# environment variables or appsettings.<Environment>.json. In Development the API already has a
# matching connection string (api/appsettings.Development.json), so you only NEED to edit this
# file if you change the database password.

# Password for the local Postgres container. Keep in sync with the API connection string:
#   ConnectionStrings__Default=Host=localhost;Port=5433;Database=crm_db;Username=crm;Password=<same>
POSTGRES_PASSWORD=crm_dev_d80f006d
