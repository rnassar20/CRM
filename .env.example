# ERP CRM — environment variables
# Copy this file to .env and fill in the real values. NEVER commit .env.
# All secrets are read at startup by api/Program.cs::ValidateRequiredSecrets (and, for
# WhatsApp MetaCloud, ValidateWhatsAppSecrets). The API refuses to start when they are
# missing or still set to the placeholder values below.

# ---------- database ----------
# Postgres container from docker-compose.yml (port 5433 on the host).
ConnectionStrings__Default=Host=localhost;Port=5433;Database=crm_db;Username=crm;Password=change_me

# ---------- JWT ----------
# Signing key for access tokens. ≥ 64 characters; hex or base64 recommended.
Jwt__Secret=change_me_change_me_change_me_change_me_change_me_change_me
Jwt__Issuer=crm-api
Jwt__Audience=crm-web
Jwt__ExpireMinutes=720

# ---------- license-key crypto ----------
# Master secret for AES-256-CBC + HMAC-SHA256 license-key encryption.
# ≥ 16 characters. Used to derive the AES key (|aes suffix) and MAC key (|mac suffix).
Licensing__Secret=change_me_change_me_ch

# ---------- WhatsApp (optional) ----------
# Provider: "Logging" (dev — messages are written to the WhatsAppMessages table only) or
# "MetaCloud" (prod — real Meta WhatsApp Cloud API sends). Default: Logging.
WhatsApp__Provider=Logging

# Only required when WhatsApp__Provider=MetaCloud. The API validates these at startup
# and refuses to start if they are missing or still set to placeholder values.
WhatsApp__MetaCloud__AccessToken=change_me_access_token
WhatsApp__MetaCloud__PhoneNumberId=change_me_phone_number_id
WhatsApp__MetaCloud__ApiVersion=v21.0

# Templates (optional overrides for the default expiry-reminder / license-delivered copy).
# WhatasApp__Templates__ExpiryReminder=Hi {contact}, ...
# WhatasApp__Templates__LicenseDelivered=Thank you {client}! ...
