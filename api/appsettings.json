{
  // NOTE: no secrets live here. Every credential below is injected at runtime via
  // environment variables (e.g. ConnectionStrings__Default, Jwt__Secret) or provided
  // by appsettings.<Environment>.json. The API refuses to start if these are empty.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "crm-api",
    "Audience": "crm-web",
    "Secret": "",
    "ExpireMinutes": 720
  },
  "Licensing": {
    "Secret": ""
  },
  "WhatsApp": {
    "Provider": "Logging",
    "MetaCloud": {
      "AccessToken": "",
      "PhoneNumberId": "",
      "ApiVersion": "v21.0"
    },
    "Templates": {
      "ExpiryReminder": "Hi {contact}, this is a reminder that your {plan} subscription for {client} expires on {expiry} ({days} day(s) left). Contact us to renew and keep your ERP active.",
      "LicenseDelivered": "Thank you {client}! Your payment for {plan} has been received.\nYour activation key:\n{key}\nOpen your ERP > Help > Activate Subscription, enter the key to stay licensed until {expiry}."
    }
  }
}
